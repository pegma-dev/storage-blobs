{
  "name": "@pegma/storage-cloudflare-r2",
  "version": "0.1.1",
  "description": "Cloudflare R2 adapter for @pegma/storage-blobs (S3-compatible API).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/storage-blobs.git",
    "directory": "packages/storage-cloudflare-r2"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@pegma/storage-blobs": "0.1.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  }
}
